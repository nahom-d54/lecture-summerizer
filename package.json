{
  "name": "lecture-summarizer",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered lecture summarizer application",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev --filter=backend\" \"pnpm run dev --filter=frontend\"",
    "dev:backend": "pnpm run dev --filter=backend",
    "dev:frontend": "pnpm run dev --filter=frontend",
    "build": "pnpm run -r build",
    "build:backend": "pnpm run build --filter=backend",
    "build:frontend": "pnpm run build --filter=frontend",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm run -r test",
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9"
}
