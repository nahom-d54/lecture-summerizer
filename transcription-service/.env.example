# Whisper model: tiny, base, small, medium, large
# "base" recommended for CPU - good balance of speed/accuracy
WHISPER_MODEL=base

# Device: cpu or cuda
DEVICE=cpu

# Enable speaker diarization (requires HF_TOKEN)
ENABLE_DIARIZATION=false

# HuggingFace token for pyannote (required if diarization enabled)
# Get from: https://huggingface.co/settings/tokens
# Must accept pyannote model terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# Server settings
HOST=0.0.0.0
PORT=8000

# Temp directory for processing
TEMP_DIR=/tmp/transcription

# Max audio duration in seconds (2 hours)
MAX_DURATION_SECONDS=7200
