# Development Dockerfile for Frontend
FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy config files
COPY tsconfig*.json vite.config.ts tailwind.config.js postcss.config.js ./
COPY index.html ./

# Expose port
EXPOSE 5173

# Start development server
CMD ["npm", "run", "dev", "--", "--host"]
